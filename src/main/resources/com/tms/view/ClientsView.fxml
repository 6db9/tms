<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<SplitPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.tms.controller.ClientController" dividerPositions="0.6">

    <!-- Left: Table -->
    <VBox spacing="10">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <Label text="Clients" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <TableView fx:id="clientTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" text="Nom" prefWidth="150"/>
                <TableColumn fx:id="colPhone" text="Téléphone" prefWidth="100"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
                <TableColumn fx:id="colTaxId" text="N° Fiscal" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Right: Form -->
    <VBox spacing="10">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
        <Label text="Nouveau Client" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <TextField fx:id="nameField" promptText="Nom (requis)"/>
        <TextField fx:id="phoneField" promptText="Téléphone"/>
        <TextField fx:id="emailField" promptText="Email"/>
        <TextField fx:id="taxIdField" promptText="N° Fiscal"/>
        <TextField fx:id="addressField" promptText="Adresse"/>

        <Button text="Enregistrer" onAction="#handleSave" maxWidth="Infinity"/>
        <Label fx:id="errorLabel" style="-fx-text-fill: red;" wrapText="true"/>
    </VBox>
</SplitPane>