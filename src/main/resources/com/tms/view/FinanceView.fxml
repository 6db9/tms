<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tms.controller.FinanceController" spacing="10">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <Label text="Suivi Financier" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <!-- Onglet Paiements -->
        <Tab text="Paiements">
            <SplitPane dividerPositions="0.6">
                <TableView fx:id="paymentTable">
                    <columns>
                        <TableColumn fx:id="colPayId" text="ID" prefWidth="40"/>
                        <TableColumn fx:id="colPayReq" text="Demande ID" prefWidth="80"/>
                        <TableColumn fx:id="colPayClient" text="Client" prefWidth="150"/>
                        <TableColumn fx:id="colPayAmount" text="Montant" prefWidth="100"/>
                        <TableColumn fx:id="colPayState" text="État" prefWidth="100"/>
                    </columns>
                </TableView>
                <VBox spacing="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Gérer un paiement" style="-fx-font-weight: bold;"/>
                    <Button text="Confirmer l'encaissement" onAction="#handleConfirm" maxWidth="Infinity"/>
                    <Button text="Rejeter" onAction="#handleReject" maxWidth="Infinity"/>
                    <Label fx:id="payErrorLabel" style="-fx-text-fill: red;" wrapText="true"/>
                </VBox>
            </SplitPane>
        </Tab>

        <!-- Onglet Dépenses -->
        <Tab text="Dépenses">
            <SplitPane dividerPositions="0.6">
                <TableView fx:id="expenseTable">
                    <columns>
                        <TableColumn fx:id="colExpId" text="ID" prefWidth="40"/>
                        <TableColumn fx:id="colExpMission" text="Mission" prefWidth="80"/>
                        <TableColumn fx:id="colExpCat" text="Catégorie" prefWidth="120"/>
                        <TableColumn fx:id="colExpAmount" text="Montant" prefWidth="100"/>
                        <TableColumn fx:id="colExpDate" text="Date" prefWidth="100"/>
                    </columns>
                </TableView>
                <VBox spacing="10">
                    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                    <Label text="Nouvelle Dépense" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="expMissionField" promptText="ID Mission"/>
                    <TextField fx:id="expCatField" promptText="Catégorie (ex: Carburant)"/>
                    <TextField fx:id="expAmountField" promptText="Montant"/>
                    <DatePicker fx:id="expDatePicker"/>
                    <TextField fx:id="expRefField" promptText="Référence"/>
                    <Button text="Ajouter" onAction="#handleAddExpense" maxWidth="Infinity"/>
                    <Label fx:id="expErrorLabel" style="-fx-text-fill: red;" wrapText="true"/>
                </VBox>
            </SplitPane>
        </Tab>
    </TabPane>
</VBox>