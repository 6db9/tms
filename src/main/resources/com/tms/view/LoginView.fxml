<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tms.controller.LoginController"
      alignment="CENTER" spacing="15">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="TMS — Connexion" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Utilisateur :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200"/>

        <Label text="Mot de passe :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="200"/>
    </GridPane>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;" wrapText="true"/>

    <Button fx:id="loginButton" text="Se connecter" onAction="#onLogin" defaultButton="true" prefWidth="120"/>
</VBox>