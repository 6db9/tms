<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tms.controller.LoginController"
      styleClass="login-root">


    <VBox styleClass="brand-panel" prefWidth="560" minWidth="280" maxWidth="530" alignment="CENTER_LEFT" spacing="14">
        <VBox styleClass="logo-box"  maxHeight="48" prefWidth="48" prefHeight="48">
            <Label text="TMS - Transport" styleClass="logo-letter"/>
            <Label text="Transport Management System - V1.0.0" styleClass="brand-sub"/>
        </VBox>

        <VBox styleClass="text-box">
            <Label text="Du devis à la livraison, un seul poste de pilotage."
                          styleClass="brand-text" wrapText="true"/>

            <HBox>
                <Label text="Parcours A" styleClass="parcours" />
                <Label text="— vente avec livraison" styleClass="parcours-text" />
            </HBox>
            <HBox>
                <Label text="Parcours B" styleClass="parcours" />
                <Label text="— transport seul" styleClass="parcours-text" />
            </HBox>
            <Label text="Planning, états de mission, déchargement, paiements et soldes." styleClass="parcours-text" />
        </VBox>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="Application Java Desktop · accès par compte individuel" styleClass="footer"/>
    </VBox>


    <VBox styleClass="form-panel" HBox.hgrow="ALWAYS" alignment="CENTER">
        <VBox styleClass="form-box" maxWidth="450" spacing="16">

            <VBox spacing="4">
                <Label text="Connexion" styleClass="form-title"/>
                <Label text="Utilisez votre compte individuel." styleClass="form-sub"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Identifiant" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="ex. s.benali"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Mot de passe" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"/>
            </VBox>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>

            <Button fx:id="loginButton" text="Se connecter" onAction="#onLogin"
                    defaultButton="true" maxWidth="Infinity" styleClass="btn"/>
        </VBox>
    </VBox>
</HBox>